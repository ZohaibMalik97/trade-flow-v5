# Copy to .env.local and adjust.

# Which API the dev server (npm run dev) talks to: local | prod
API_TARGET=local

LOCAL_API_URL=https://localhost:7180
PROD_API_URL=http://192.168.19.43:8082

# Base URL the browser uses for API calls. Leave as /api/v1 in development (Vite forwards it to the
# API chosen above). Production builds take it from .env.production.
VITE_API_BASE_URL=/api/v1
