# Committed defaults live in .env; production builds use .env.production (API_TARGET=prod).
# Copy this to .env.local to switch the API for npm run dev on your machine.

# Which API the browser calls: local | prod
API_TARGET=local

# Optional: an exact API base URL, overriding API_TARGET.
# VITE_API_BASE_URL=https://tradeflowapi.ertradetrack.com:8082/api/v1
